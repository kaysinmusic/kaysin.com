---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const logoSource = readFileSync(
  resolve(process.cwd(), 'public/images/wordmark-white.svg'),
  'utf8',
);
const viewBox = logoSource.match(/\bviewBox="([^"]+)"/)?.[1] ?? '0 0 666 102';
const paths = [...logoSource.matchAll(/<path\b[^>]*\bd="([^"]+)"[^>]*\/?>/g)].map((match) => match[1]);
---
<svg
  class="wordmark-draw"
  viewBox={viewBox}
  role="img"
  aria-labelledby="kaysin-wordmark-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="kaysin-wordmark-title">Kaysin</title>
  {paths.map((path) => <path d={path} />)}
</svg>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    document.querySelectorAll('.wordmark-draw').forEach((logo) => {
      const paths = logo.querySelectorAll('path');
      paths.forEach((path, index) => {
        path.style.setProperty('--path-length', `${path.getTotalLength()}`);
        path.style.setProperty('--draw-delay', `${index * 85}ms`);
      });
      logo.classList.add('is-drawing');
    });
  }
</script>

<style>
  .wordmark-draw {
    display: block;
    width: clamp(220px, 30vw, 410px);
    height: auto;
    overflow: visible;
  }

  .wordmark-draw path {
    fill: #fff;
  }

  .wordmark-draw.is-drawing path {
    fill-opacity: 0;
    stroke: #fff;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: var(--path-length);
    stroke-dashoffset: var(--path-length);
    animation: wordmark-trace 1.08s cubic-bezier(.55, 0, .34, 1) var(--draw-delay) forwards;
  }

  @keyframes wordmark-trace {
    0% {
      stroke-dashoffset: var(--path-length);
      stroke-opacity: .82;
      fill-opacity: 0;
    }
    76% {
      stroke-dashoffset: 0;
      stroke-opacity: .82;
      fill-opacity: 0;
    }
    100% {
      stroke-dashoffset: 0;
      stroke-opacity: 0;
      fill-opacity: 1;
    }
  }

  @media (max-width: 600px) {
    .wordmark-draw { width: min(67vw, 290px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark-draw path {
      animation: none !important;
      fill: #fff !important;
      fill-opacity: 1 !important;
      stroke: none !important;
    }
  }
</style>
