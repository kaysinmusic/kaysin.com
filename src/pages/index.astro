---
import WordmarkDraw from '../components/WordmarkDraw.astro';

const links = [
  { label: 'Instagram', href: 'https://www.instagram.com/kaysin/' },
  { label: 'Spotify', href: 'https://open.spotify.com/artist/10mZhaOPNKtQfg46DptrBU' },
  { label: 'SoundCloud', href: 'https://soundcloud.com/kaysin' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Kaysin. Coming soon." />
    <meta name="theme-color" content="#10101c" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <title>Kaysin — Coming soon</title>
  </head>
  <body>
    <main class="stage">
      <picture class="stage-image" aria-hidden="true">
        <source media="(max-width: 600px)" srcset="/images/booth-red.webp" />
        <img src="/images/live-still.jpg" alt="" />
      </picture>
      <div class="shade" aria-hidden="true"></div>
      <div class="content">
        <header>
          <h1><WordmarkDraw /></h1>
          <p class="role">DJ · Producer · A&amp;R</p>
        </header>
        <div class="announcement">
          <p class="message">Coming soon</p>
          <nav aria-label="Kaysin on social and music platforms">
            {links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
          </nav>
        </div>
      </div>
    </main>
  </body>
</html>
<style>
  @font-face { font-family: Istok; src: url('/fonts/istok-regular.ttf') format('truetype'); font-display: swap; }
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #10101c; color: #fff; font-family: Istok, Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(body) { margin: 0; }
  .stage { position: relative; isolation: isolate; min-height: 100vh; min-height: 100svh; overflow: hidden; background: #10101c; }
  .stage-image, .stage-image img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage-image { z-index: -2; }
  .stage-image img { object-fit: cover; object-position: center 48%; }
  .shade { z-index: -1; background: linear-gradient(180deg, rgba(9,9,17,.70) 0%, rgba(10,9,17,.12) 35%, rgba(10,9,17,.18) 55%, rgba(9,9,17,.88) 100%); }
  .content { min-height: 100vh; min-height: 100svh; padding: max(42px, env(safe-area-inset-top)) max(5vw, env(safe-area-inset-right)) max(48px, env(safe-area-inset-bottom)) max(5vw, env(safe-area-inset-left)); display: flex; flex-direction: column; justify-content: space-between; gap: 180px; }
  header h1 { margin: 0; line-height: 0; }
  h1 img { display: block; width: clamp(220px, 30vw, 410px); height: auto; }
  .role { margin: 18px 0 0; font-size: 14px; letter-spacing: .07em; text-transform: uppercase; }
  .message { margin: 0 0 17px; font-size: clamp(28px, 3.4vw, 46px); line-height: 1.1; letter-spacing: -.025em; }
  nav { display: flex; align-items: center; flex-wrap: wrap; column-gap: 30px; }
  nav a { display: inline-flex; min-height: 44px; align-items: center; color: #fff; font-size: 15px; text-decoration-color: rgba(255,255,255,.55); text-underline-offset: 5px; text-decoration-thickness: 1px; }
  a:focus-visible { outline: 2px solid #b5b9ec; outline-offset: 4px; }
  @media (hover: hover) { nav a:hover { color: #c2c6ff; text-decoration-color: currentColor; } }
  @media (max-width: 600px) {
    .stage-image img { object-position: center center; }
    .shade { background: linear-gradient(180deg, rgba(9,9,17,.77) 0%, rgba(10,9,17,.12) 32%, rgba(10,9,17,.08) 50%, rgba(9,9,17,.91) 100%); }
    .content { padding: max(32px, env(safe-area-inset-top)) max(25px, env(safe-area-inset-right)) max(36px, env(safe-area-inset-bottom)) max(25px, env(safe-area-inset-left)); gap: 160px; }
    h1 img { width: min(67vw, 290px); }
    .role { margin-top: 14px; font-size: 13px; }
    .message { font-size: 32px; margin-bottom: 12px; }
    nav { column-gap: 23px; }
    nav a { font-size: 14px; }
  }
</style>